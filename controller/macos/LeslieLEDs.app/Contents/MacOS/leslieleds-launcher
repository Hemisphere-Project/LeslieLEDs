#!/bin/sh
set -eu

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
LOG_DIR="$HOME/Library/Logs/LeslieLEDs"
WRAPPER_LOG="$LOG_DIR/app-wrapper.log"

mkdir -p "$LOG_DIR"
touch "$WRAPPER_LOG"
exec >> "$WRAPPER_LOG" 2>&1

echo
echo "[wrapper] $(date '+%Y-%m-%d %H:%M:%S') starting LeslieLEDs.app launcher"

show_alert() {
    if [ -x /usr/bin/osascript ]; then
        /usr/bin/osascript -e "display alert \"LeslieLEDs Launcher\" message \"$1\"" >/dev/null 2>&1 || true
    fi
}

show_repo_access_hint() {
    show_alert "macOS blocked LeslieLEDs.app from reading this repo. Move the LeslieLEDs checkout out of Desktop/Documents/Downloads, for example to ~/Code/LeslieLEDs, then launch again."
}

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CONTROLLER_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../../../.." && pwd)

echo "[wrapper] script dir: $SCRIPT_DIR"
echo "[wrapper] controller dir: $CONTROLLER_DIR"

if [ ! -f "$CONTROLLER_DIR/launcher.py" ]; then
    echo "[wrapper] ERROR: controller/launcher.py not found"
    show_alert "Could not find controller/launcher.py. Keep LeslieLEDs.app inside controller/macos/ in the repository checkout."
    exit 1
fi

if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN=python
elif [ -x /opt/homebrew/bin/python3 ]; then
    PYTHON_BIN=/opt/homebrew/bin/python3
elif [ -x /usr/local/bin/python3 ]; then
    PYTHON_BIN=/usr/local/bin/python3
else
    echo "[wrapper] ERROR: python3 not found in PATH=$PATH"
    show_alert "python3 was not found. Install Python 3 and try again."
    exit 1
fi

echo "[wrapper] python: $PYTHON_BIN"
echo "[wrapper] checking bootstrap readability via python"
if ! "$PYTHON_BIN" -c 'import pathlib, sys; pathlib.Path(sys.argv[1]).read_bytes()' "$CONTROLLER_DIR/launcher.py"; then
    echo "[wrapper] ERROR: python cannot read launcher.py"
    case "$CONTROLLER_DIR" in
        "$HOME"/Desktop/*|"$HOME"/Documents/*|"$HOME"/Downloads/*)
            echo "[wrapper] Likely macOS privacy protection on Desktop/Documents/Downloads"
            show_repo_access_hint
            ;;
        *)
            show_alert "LeslieLEDs could not read controller/launcher.py. See $WRAPPER_LOG for details."
            ;;
    esac
    exit 1
fi
echo "[wrapper] launching bootstrap"
exec "$PYTHON_BIN" "$CONTROLLER_DIR/launcher.py" "$@"
# exec replaces this shell process; lines below only run if exec itself fails
echo "[wrapper] ERROR: exec of python launcher failed"
show_alert "LeslieLEDs failed to start. See $WRAPPER_LOG for details."
exit 1